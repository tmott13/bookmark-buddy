{
  "name": "Bookmark Buddy",
  "short_name": "Bookmark Buddy",
  "description": "Tidy your bookmarks with Gemma, privately in your browser.",
  "display": "standalone",
  "scope": "./",
  "start_url": "./",
  "theme_color": "#3f5a36",
  "background_color": "#fbf6ec",
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
